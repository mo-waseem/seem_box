SEEM_BOX_LLM_PROVIDER=codex
SEEM_BOX_CODEX_MODEL=gpt-5.4
SEEM_BOX_COMPAT_BASE_URL=http://127.0.0.1:8080
SEEM_BOX_COMPAT_MODEL=gpt-4o-mini
SEEM_BOX_COMPAT_API_KEY=

# Set a private random token of at least 32 characters to enable extension access.
SEEM_BOX_EXTENSION_TOKEN=

# Cloudflare only: set this separately as an encrypted Worker secret.
# Browser login username is admin. Use a different random value from the extension token.
# SEEM_BOX_ADMIN_PASSWORD=
# The standalone Worker uses its Durable Object binding directly. Leave
# SEEM_BOX_AUTH_STORAGE unset for the local Next.js toolbox's file storage.
